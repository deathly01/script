-- updatePlayerLoop
local function updatePlayerLoop()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local langData = Translations[currentLang] or Translations.TH
	local elapsed = os.clock() - scriptStartClock
	playTimeLabel.Text = langData.PlayTimeText .. " " .. FormatTime(elapsed)

	if hum then
		if GodModeEnabled then
			hum.MaxHealth = 999999
			hum.Health = 999999
		end
		local hp = math.max(0, math.floor(hum.Health))
		local maxHp = math.floor(hum.MaxHealth)
		local percent = math.clamp(hp / maxHp, 0, 1)
		healthTextLabel.Text = langData.HealthText .. " " .. (GodModeEnabled and "∞" or hp) .. " / " .. (GodModeEnabled and "∞" or maxHp)
		healthBarFill.Size = UDim2.new(GodModeEnabled and 1 or percent, 0, 1, 0)
		if percent > 0.5 or GodModeEnabled then
			healthBarFill.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
		elseif percent > 0.2 then
			healthBarFill.BackgroundColor3 = Color3.fromRGB(241, 196, 15)
		else
			healthBarFill.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
		end
		if SpeedEnabled then
			hum.WalkSpeed = WalkSpeedValue
		end
	else
		healthTextLabel.Text = langData.HealthText .. " 0 / 0"
		healthBarFill.Size = UDim2.new(0, 0, 1, 0)
	end

	if InvisEnabled then
		setCharacterInvisibility(true)
	end
end
