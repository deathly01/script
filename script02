local function stopFlying()
	if flyBodyVel then flyBodyVel:Destroy() flyBodyVel = nil end
	if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
end

local function startFlying()
	stopFlying()
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	flyBodyVel = Instance.new("BodyVelocity")
	flyBodyVel.MaxForce = Vector3.new(1, 1, 1) * 9e9
	flyBodyVel.Velocity = Vector3.zero
	flyBodyVel.Parent = hrp
	flyBodyGyro = Instance.new("BodyGyro")
	flyBodyGyro.MaxTorque = Vector3.new(1, 1, 1) * 9e9
	flyBodyGyro.CFrame = hrp.CFrame
	flyBodyGyro.Parent = hrp
	task.spawn(function()
		while FlyEnabled and hrp and flyBodyVel and flyBodyGyro do
			flyBodyGyro.CFrame = Camera.CFrame
			flyBodyVel.Velocity = Camera.CFrame.LookVector * FlySpeedValue
			task.wait()
		end
		stopFlying()
	end)
end

