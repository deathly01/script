	local btn = Instance.new("TextButton")
	btn.Name = keyName .. "_Btn"
	btn.Size = UDim2.new(1, 0, 0, 32)
	btn.BackgroundTransparency = 1
	btn.Text = Translations.TH.Tabs[keyName]
	btn.TextColor3 = (index == 1) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(120, 120, 135)
	btn.TextSize = 13
	btn.Font = Enum.Font.GothamBold
	btn.TextXAlignment = Enum.TextXAlignment.Left
	btn.LayoutOrder = index
	btn.Parent = sidebar
	tabButtons[keyName] = btn

	local page = Instance.new("ScrollingFrame")
	page.Name = keyName .. "_Page"
	page.Size = UDim2.new(1, 0, 1, 0)
	page.BackgroundTransparency = 1
	page.BorderSizePixel = 0
	page.ScrollBarThickness = 3
	page.ScrollBarImageColor3 = Color3.fromRGB(60, 60, 75)
	page.Visible = (index == 1)
	page.Parent = contentContainer

	local pageList = Instance.new("UIListLayout")
	pageList.SortOrder = Enum.SortOrder.LayoutOrder
	pageList.Padding = UDim.new(0, 10)
	pageList.Parent = page
	pageList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		page.CanvasSize = UDim2.fromOffset(0, pageList.AbsoluteContentSize.Y + 15)
	end)
	tabPages[keyName] = page

	btn.Activated:Connect(function()
		for name, pageFrame in pairs(tabPages) do
			pageFrame.Visible = (name == keyName)
		end
		for name, buttonObj in pairs(tabButtons) do
			buttonObj.TextColor3 = (name == keyName) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(120, 120, 135)
		end
	end)
end

